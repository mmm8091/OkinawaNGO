# Preserve source-archive evidence byte-for-byte; text normalization invalidates SHA256.
source_docs/source_archive/**/raw.* binary

# W2-00 freezes downloaded official evidence bytes and verifies them by SHA-256.
outputs/us_presence_network_wave2_w2_00_*_v1/artifacts/** binary
outputs/us_presence_network_wave2_w2_00_*_v1/raw/** binary
